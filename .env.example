# Copy this file to `.env` and fill in your own values. Never commit the real `.env`.

# ---- LLM provider (OpenAI-compatible endpoint) ----
LLM_BASE_URL=https://api.your-llm-provider.com/v1
LLM_API_KEY=your_llm_api_key
CHAT_MODEL=your/chat-model
# Optional fallback provider used automatically if the primary is unavailable
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_MODELS=
LLM_CONCURRENCY=8

# ---- Embeddings micro-service (for hybrid search) ----
EMBED_URL=http://127.0.0.1:7867

# ---- Optional integrations ----
OCR_URL=
ASSEMBLYAI_KEY=
LANGSEARCH_KEY=
TRANSLATOR_URL=http://127.0.0.1:7865

# ---- WhatsApp bot identity ----
# Bot phone number in international format, digits only (no +).
PHONE=

# ---- Groups (comma-separated WhatsApp group ids, e.g. 1234567890@g.us) ----
ALLOWED_GROUPS=
ANSWER_GROUPS=
ANNOUNCE_GROUPS=
CONTROL_GROUP=
METI_GROUP=
WADHWANI_GROUP=
WADHWANI_ANSWER_GROUP=
ARENA_GROUP=

# ---- Owner / admins ----
# Owner JIDs allowed to run control commands (comma-separated).
OWNER_JIDS=
# Admin display names (comma-separated, case-insensitive).
ADMIN_NAMES=
# Admin phone numbers (comma-separated, digits only).
ADMIN_NUMBERS=
# Admin JIDs as JSON map name -> jid, e.g. {"jane doe":"1234567890@s.whatsapp.net"}
ADMIN_JIDS={}

# ---- Behaviour flags ----
AUTO_REPLY=1
GROUP_ANSWER=1
DM_ALWAYS_OPEN=1
DM_MAX=1000000
ARENA_ENABLED=0
ARENA_QUORUM=10

# ---- Deterministic meeting links (kept out of source; optional) ----
WADHWANI_MEETING_LINK=
OPENHOUR_MEETING_LINK=
# Newline- or comma-separated list of canonical links the bot may repair if the model truncates them
CANONICAL_LINKS=
